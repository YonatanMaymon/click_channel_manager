# Copy this file to .env and fill in real values where needed.
# .env is ignored by git; never commit real secrets.

# Local development Postgres from compose.yaml (`pnpm db:start`).
# Tests use the test database instead; see .env.test.
DATABASE_URL=postgres://click:click@127.0.0.1:5432/click_dev

# Only if ports 5432/5433 are already taken on this computer: pick free ones
# here, then change the port in DATABASE_URL above and in .env.test to match.
# POSTGRES_PORT=5432
# POSTGRES_TEST_PORT=5433
