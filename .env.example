# Copy this file to .env and fill in real values where needed.
# .env is ignored by git; never commit real secrets.

# Local development Postgres from compose.yaml (`pnpm db:start`).
# Tests use the test database instead; see .env.test.
DATABASE_URL=postgres://click:click@127.0.0.1:5432/click_dev

# Only if ports 5432/5433 are already taken on this computer: pick free ones
# here, then change the port in DATABASE_URL above and in .env.test to match.
# POSTGRES_PORT=5432
# POSTGRES_TEST_PORT=5433

# Sentry (error tracking) is off while these are unset, which is what you want
# on your own computer: errors show in the terminal instead. On Railway they're
# set in .railway/railway.ts. To try Sentry locally, copy the DSN from there.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# SMS through 019 (src/lib/sms). Only staging and production send real SMS;
# on your computer messages are printed in the terminal, whatever is set here.
# Fill these in only to run `pnpm sms:test-send`, which checks the real 019
# connection. The token is secret: create it on 019's site, and note its
# expiry date, because it can't be renewed.
# SMS_019_USERNAME=
# SMS_019_TOKEN=
# SMS_SENDER=   # up to 11 English letters or digits, approved by 019
